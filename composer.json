{
  "name": "ncdlabs/complyops",
  "description": "Continuous technical compliance operations for WordPress",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "chrome-php/chrome": "^1.14",
    "symfony/filesystem": "^6.4",
    "symfony/process": "^6.4"
  },
  "autoload": {
    "psr-4": {
      "ComplyOps\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.1.0"
    }
  }
}
